JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Prisma Postgres. The pooled URL is used when it is set.
# Vercel may inject these without the DB_ prefix.
DB_DATABASE_URL_POOLED=postgres://USER:PASSWORD@pooled.db.prisma.io:5432/postgres?sslmode=require
DB_DATABASE_URL=postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require
# 32 random bytes, base64. Leave unset to generate backend/.encryption_key.
FILE_ENCRYPTION_KEY=
